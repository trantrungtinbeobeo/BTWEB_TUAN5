@model IEnumerable<BTVD_TUAN5.Models.Book>
@{
    ViewData["Title"] = "Quản lý sách";
    var topicCounts = ViewBag.TopicCounts as IEnumerable<BTVD_TUAN5.Controllers.TopicCountViewModel>;
}

<h1>Danh sách sách</h1>
<p><a class="btn btn-primary" asp-action="Create">Thêm sách</a></p>

<div class="mb-3">
    <strong>Chủ đề:</strong>
    @if (topicCounts != null)
    {
        foreach (var topic in topicCounts)
        {
            <span class="badge bg-secondary me-2">@topic.Name (@topic.Count)</span>
        }
    }
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Tên sách</th><th>Tác giả</th><th>Chủ đề</th><th>Giá</th><th>SL</th><th>Ảnh</th><th></th></tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Title</td><td>@item.Author</td><td>@item.Topic?.Name</td><td>@item.Price.ToString("N0")</td><td>@item.Quantity</td>
            <td>
                @if (!string.IsNullOrEmpty(item.ImageFileName))
                {
                    <img src="~/Content/ImageBooks/@item.ImageFileName" width="60" alt="@item.Title" />
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.BookId">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.BookId">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.BookId">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
