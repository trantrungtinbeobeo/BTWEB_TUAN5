@model IEnumerable<BTVD_TUAN5.Models.Book>
@{
    ViewData["Title"] = "Quản lý sách";
    var topicCounts = ViewBag.TopicCounts as IEnumerable<BTVD_TUAN5.Models.TopicCountViewModel>;
}

<section class="admin-panel mb-4">
    <h1>Khu vực quản trị sách</h1>
    <p class="mb-2">Trang này dành cho quản trị viên với các chức năng thêm, sửa, xóa sách.</p>
    <a class="btn btn-primary" asp-action="Create">+ Thêm sách mới</a>
</section>

<div class="mb-3">
    <strong>Chủ đề hiện có:</strong>
    @if (topicCounts != null)
    {
        foreach (var topic in topicCounts)
        {
            <span class="badge text-bg-light border ms-2">@topic.Name (@topic.Count)</span>
        }
    }
</div>

<table class="table table-hover table-bordered bg-white align-middle">
    <thead class="table-light">
        <tr><th>Tên sách</th><th>Tác giả</th><th>Chủ đề</th><th>Giá</th><th>SL</th><th>Ảnh</th><th>Thao tác</th></tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Title</td><td>@item.Author</td><td>@item.Topic?.Name</td><td>@item.Price.ToString("N0") đ</td><td>@item.Quantity</td>
            <td>
                @if (!string.IsNullOrEmpty(item.ImageFileName))
                {
                    <img src="~/Content/ImageBooks/@item.ImageFileName" width="60" class="rounded" alt="@item.Title" />
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.BookId">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.BookId">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.BookId">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
