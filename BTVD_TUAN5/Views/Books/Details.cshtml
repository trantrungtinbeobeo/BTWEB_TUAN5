@model BTVD_TUAN5.Models.Book
<h1>Chi tiết sách</h1>
<dl class="row">
    <dt class="col-sm-2">Tên</dt><dd class="col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Tác giả</dt><dd class="col-sm-10">@Model.Author</dd>
    <dt class="col-sm-2">Chủ đề</dt><dd class="col-sm-10">@Model.Topic?.Name</dd>
    <dt class="col-sm-2">Giá</dt><dd class="col-sm-10">@Model.Price</dd>
    <dt class="col-sm-2">Số lượng</dt><dd class="col-sm-10">@Model.Quantity</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
