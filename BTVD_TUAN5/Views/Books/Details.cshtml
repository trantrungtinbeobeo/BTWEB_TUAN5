@model BTVD_TUAN5.Models.Book
@{
    ViewData["Title"] = "Chi tiết sách";
}

<section class="detail-card">
    <div class="detail-cover">
        @if (!string.IsNullOrEmpty(Model.ImageFileName))
        {
            <img src="~/Content/ImageBooks/@Model.ImageFileName" alt="@Model.Title" />
        }
        else
        {
            <div class="placeholder-cover">BOOK</div>
        }
    </div>
    <div class="detail-content">
        <h1>@Model.Title</h1>
        <p class="author">@Model.Author</p>
        <div class="detail-grid">
            <div><span>Chủ đề</span><strong>@Model.Topic?.Name</strong></div>
            <div><span>Giá bán</span><strong>@Model.Price.ToString("N0") đ</strong></div>
            <div><span>Tồn kho</span><strong>@Model.Quantity cuốn</strong></div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Về quản lý sách</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Về trang mua sách</a>
        </div>
    </div>
</section>
